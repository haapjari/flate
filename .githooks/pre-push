#!/usr/bin/env bash

# pre-push hook: refuses direct pushes to main.
# main is protected on GitHub; changes go through a pull request.

set -o errexit
set -o nounset
set -o pipefail

while read -r _local_ref _local_sha remote_ref _remote_sha; do
    if [[ "${remote_ref}" == "refs/heads/main" ]]; then
        echo "ERROR: direct pushes to main are not allowed" >&2
        echo "" >&2
        echo "Push a branch and open a pull request instead." >&2
        exit 1
    fi
done
